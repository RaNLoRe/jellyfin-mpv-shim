+-- Keep the same overlay, cursor and dynamic key bindings; only its data source
+-- changes. Entry identities retain the cursor across queue edits and duplicates.
+jellyfin_queue.listen(function(previous, current)
+    local changed = not previous or previous.current ~= current.current
+        or #previous.items ~= #current.items
+    if not changed then
+        for i, item in ipairs(current.items) do
+            local old = previous.items[i]
+            if old.entry ~= item.entry or old.title ~= item.title then changed = true; break end
+        end
+    end
+    if not changed then return end
+    local wanted = previous and previous.items[cursor + 1]
+    wanted = current.focus or (wanted and wanted.entry)
+    if not previous or previous.current ~= current.current then wanted = current.current end
+    cursor = math.max(0, math.min(cursor, #current.items - 1))
+    for i, item in ipairs(current.items) do
+        if item.entry == wanted then cursor = i - 1; break end
+    end
+    if not current.focus or not previous or previous.current ~= current.current then selection = nil end
+    if #current.items == 0 then remove_keybinds() else refresh_UI() end
+end)
+mp.add_periodic_timer(1, function()
